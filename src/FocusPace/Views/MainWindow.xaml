<Window x:Class="FocusPace.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FocusPace.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:FocusPace.Models"
        Title="Focus Pace"
        Width="460" Height="462"
        MinWidth="380" MinHeight="392"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="1" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="20" CornerRadius="10" Background="{DynamicResource SecondaryHoverBrush}">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsChipStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ColorDotStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Visibility="Collapsed" />
                            <Ellipse Fill="{TemplateBinding Background}" Margin="4" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource CaptionButtonStyle}" Click="Settings_OnClick" ToolTip="Settings" AutomationProperties.Name="Settings" />
                <Button Content="&#xE921;" Style="{StaticResource CaptionButtonStyle}" Click="Minimize_OnClick" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
                <Button Content="&#xE922;" Style="{StaticResource CaptionButtonStyle}" IsEnabled="False" AutomationProperties.Name="Maximize" />
                <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButtonStyle}" Click="Close_OnClick" ToolTip="Close" AutomationProperties.Name="Close" />
            </StackPanel>
        </Grid>
    <ScrollViewer x:Name="MainView" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
        <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" MinHeight="165" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding PhaseLabel}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Grid Grid.Row="1" Margin="0,6,0,10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GoalMark}" FontSize="23" Foreground="{Binding ProgressFillBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding TimeText}" FontSize="34" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding TargetText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                </Grid>
                <ProgressBar Grid.Row="2" Height="7" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="{Binding ProgressFillBrush}" Background="{DynamicResource InputSurfaceBrush}" BorderThickness="0" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" MinHeight="86" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="14,10" Cursor="IBeam" PreviewMouseLeftButtonDown="FocusGoalCard_OnPreviewMouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="Focus Goal (min)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" />
                    <controls:NumericUpDown x:Name="FocusGoalInput" Value="{Binding FocusMinutes, Mode=TwoWay}" Minimum="1" Maximum="240"
                                            Height="38" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                                            ToolTip="Click anywhere to enter a value" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" MinHeight="86" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="14,10" Cursor="IBeam" PreviewMouseLeftButtonDown="RestGoalCard_OnPreviewMouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="Rest Goal (min)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" />
                    <controls:NumericUpDown x:Name="RestGoalInput" Value="{Binding RestMinutes, Mode=TwoWay}" Minimum="1" Maximum="60"
                                            Height="38" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                                            ToolTip="Click anywhere to enter a value" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4">
            <Button Content="{Binding PrimaryActionText}" Command="{Binding PrimaryCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Start Rest now" Command="{Binding StartRestCommand}"
                    Visibility="{Binding CanStartRest, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,7,0,0" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Start Focus now" Command="{Binding StartFocusCommand}"
                    Visibility="{Binding CanStartFocus, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,7,0,0" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
    <Grid x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed">
        <StackPanel Margin="24,4,24,16">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10" />
            <CheckBox Content="Start with Windows" Style="{StaticResource SettingsToggleStyle}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
            <CheckBox Content="Voice announcements" Style="{StaticResource SettingsToggleStyle}" IsChecked="{Binding VoiceAnnouncementsEnabled, Mode=TwoWay}" />
            <CheckBox Content="Always on top" Style="{StaticResource SettingsToggleStyle}" IsChecked="{Binding WidgetAlwaysOnTop, Mode=TwoWay}" />
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,4" />
            <Grid Margin="0,11">
                <TextBlock Text="Widget style" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Bar" Style="{StaticResource SettingsChipStyle}" Tag="{Binding IsBarWidget, Mode=OneWay}" Command="{Binding SelectWidgetStyleCommand}" CommandParameter="{x:Static models:WidgetStyleKind.Bar}" />
                    <Button Content="Ring" Style="{StaticResource SettingsChipStyle}" Tag="{Binding IsRingWidget, Mode=OneWay}" Command="{Binding SelectWidgetStyleCommand}" CommandParameter="{x:Static models:WidgetStyleKind.Ring}" />
                    <Button Content="Fluid" Style="{StaticResource SettingsChipStyle}" Tag="{Binding IsFluidWidget, Mode=OneWay}" Command="{Binding SelectWidgetStyleCommand}" CommandParameter="{x:Static models:WidgetStyleKind.Fluid}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,11">
                <TextBlock Text="Widget motion" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Dynamic" Style="{StaticResource SettingsChipStyle}" Tag="{Binding IsWidgetAnimated, Mode=OneWay}" Command="{Binding SelectWidgetMotionCommand}" CommandParameter="{x:Static models:WidgetMotionKind.Dynamic}" />
                    <Button Content="Static" Style="{StaticResource SettingsChipStyle}" Tag="{Binding IsStaticWidget, Mode=OneWay}" Command="{Binding SelectWidgetMotionCommand}" CommandParameter="{x:Static models:WidgetMotionKind.Static}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,11">
                <TextBlock Text="Widget opacity" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="100%" Style="{StaticResource SettingsChipStyle}" Tag="{Binding IsWidgetOpacity100, Mode=OneWay}" Command="{Binding SelectWidgetOpacityCommand}" CommandParameter="{x:Static models:WidgetOpacityKind.Opacity100}" />
                    <Button Content="90%" Style="{StaticResource SettingsChipStyle}" Tag="{Binding IsWidgetOpacity90, Mode=OneWay}" Command="{Binding SelectWidgetOpacityCommand}" CommandParameter="{x:Static models:WidgetOpacityKind.Opacity90}" />
                    <Button Content="80%" Style="{StaticResource SettingsChipStyle}" Tag="{Binding IsWidgetOpacity80, Mode=OneWay}" Command="{Binding SelectWidgetOpacityCommand}" CommandParameter="{x:Static models:WidgetOpacityKind.Opacity80}" />
                    <Button Content="70%" Style="{StaticResource SettingsChipStyle}" Tag="{Binding IsWidgetOpacity70, Mode=OneWay}" Command="{Binding SelectWidgetOpacityCommand}" CommandParameter="{x:Static models:WidgetOpacityKind.Opacity70}" />
                    <Button Content="60%" Style="{StaticResource SettingsChipStyle}" Tag="{Binding IsWidgetOpacity60, Mode=OneWay}" Command="{Binding SelectWidgetOpacityCommand}" CommandParameter="{x:Static models:WidgetOpacityKind.Opacity60}" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,11">
                <TextBlock Text="Color" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ColorDotStyle}" ToolTip="Brand" Tag="{Binding IsBrandTheme, Mode=OneWay}" Command="{Binding SelectColorThemeCommand}" CommandParameter="{x:Static models:ColorThemeKind.Brand}">
                        <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#668DD8" Offset="0" /><GradientStop Color="#8875DE" Offset="0.25" /><GradientStop Color="#D06F91" Offset="0.5" /><GradientStop Color="#D39448" Offset="0.75" /><GradientStop Color="#43A68F" Offset="1" /></LinearGradientBrush></Button.Background>
                    </Button>
                    <Button Style="{StaticResource ColorDotStyle}" ToolTip="Ocean" Background="#668DD8" Tag="{Binding IsOceanTheme, Mode=OneWay}" Command="{Binding SelectColorThemeCommand}" CommandParameter="{x:Static models:ColorThemeKind.Ocean}" />
                    <Button Style="{StaticResource ColorDotStyle}" ToolTip="Violet" Background="#8875DE" Tag="{Binding IsVioletTheme, Mode=OneWay}" Command="{Binding SelectColorThemeCommand}" CommandParameter="{x:Static models:ColorThemeKind.Violet}" />
                    <Button Style="{StaticResource ColorDotStyle}" ToolTip="Mint" Background="#43A68F" Tag="{Binding IsMintTheme, Mode=OneWay}" Command="{Binding SelectColorThemeCommand}" CommandParameter="{x:Static models:ColorThemeKind.Mint}" />
                    <Button Style="{StaticResource ColorDotStyle}" ToolTip="Amber" Background="#D39448" Tag="{Binding IsAmberTheme, Mode=OneWay}" Command="{Binding SelectColorThemeCommand}" CommandParameter="{x:Static models:ColorThemeKind.Amber}" />
                    <Button Style="{StaticResource ColorDotStyle}" ToolTip="Rose" Background="#D06F91" Tag="{Binding IsRoseTheme, Mode=OneWay}" Command="{Binding SelectColorThemeCommand}" CommandParameter="{x:Static models:ColorThemeKind.Rose}" />
                    <Button Style="{StaticResource ColorDotStyle}" ToolTip="Silver" Background="#8B96A5" Tag="{Binding IsSilverTheme, Mode=OneWay}" Command="{Binding SelectColorThemeCommand}" CommandParameter="{x:Static models:ColorThemeKind.Silver}" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Viewbox Width="30" Height="30" VerticalAlignment="Center">
                <Grid Width="38" Height="38">
                    <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 22.33,3.35 A 16,16 0 1 1 7.11,8.30" />
                </Grid>
            </Viewbox>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Focus Pace" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,1" />
                </StackPanel>
                <TextBlock Text="Stay focused. Keep your pace." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
    </Border>
</Window>
