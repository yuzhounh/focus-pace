<Window x:Class="FocusPace.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FocusPace.Controls"
        Title="Focus Pace"
        Width="460" Height="560"
        MinWidth="420" MinHeight="530"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="30,28,30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="38" Height="38">
                <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="6" />
                <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 19,3 A 16,16 0 1 1 7.7,7.7" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Focus Pace" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Stay focused. Keep your pace." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" MinHeight="165" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding PhaseLabel}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Grid Grid.Row="1" Margin="0,6,0,10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GoalMark}" FontSize="23" Foreground="{Binding ProgressFillBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding TimeText}" FontSize="34" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding TargetText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                </Grid>
                <ProgressBar Grid.Row="2" Height="7" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="{Binding ProgressFillBrush}" Background="{DynamicResource InputSurfaceBrush}" BorderThickness="0" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" MinHeight="86" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="14,10" Cursor="IBeam" PreviewMouseLeftButtonDown="FocusGoalCard_OnPreviewMouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="Focus Goal (min)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" />
                    <controls:NumericUpDown x:Name="FocusGoalInput" Value="{Binding FocusMinutes, Mode=TwoWay}" Minimum="1" Maximum="240"
                                            Height="38" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                                            ToolTip="Click anywhere to enter a value" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" MinHeight="86" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="14,10" Cursor="IBeam" PreviewMouseLeftButtonDown="RestGoalCard_OnPreviewMouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="Rest Goal (min)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" />
                    <controls:NumericUpDown x:Name="RestGoalInput" Value="{Binding RestMinutes, Mode=TwoWay}" Minimum="1" Maximum="60"
                                            Height="38" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                                            ToolTip="Click anywhere to enter a value" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="6">
            <Button Content="{Binding PrimaryActionText}" Command="{Binding PrimaryCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Start Rest now" Command="{Binding StartRestCommand}"
                    Visibility="{Binding CanStartRest, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,7,0,0" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Start Focus now" Command="{Binding StartFocusCommand}"
                    Visibility="{Binding CanStartFocus, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,7,0,0" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
