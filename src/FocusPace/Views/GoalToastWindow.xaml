<Window x:Class="FocusPace.Views.GoalToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" Height="146"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓" Foreground="{Binding ProgressFillBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,9,0" />
                <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="27,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
            <Button x:Name="ActionButton" Grid.Row="2" Margin="27,13,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Padding="13,7" Style="{StaticResource PrimaryButtonStyle}" Click="ActionButton_OnClick" />
        </Grid>
    </Border>
</Window>

