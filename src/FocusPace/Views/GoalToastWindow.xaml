<Window x:Class="FocusPace.Views.GoalToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="230" Height="96"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Topmost="{Binding WidgetAlwaysOnTop}" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="18,15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2" />
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="Rest complete"
                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold"
                       TextAlignment="Center" HorizontalAlignment="Stretch" />
            <TextBlock x:Name="MessageText" Text="Ready when you are." Margin="0,8,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"
                       TextAlignment="Center" HorizontalAlignment="Stretch" />
        </StackPanel>
    </Border>
</Window>
