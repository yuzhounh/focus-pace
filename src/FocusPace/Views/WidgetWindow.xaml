<Window x:Class="FocusPace.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:FocusPace.Infrastructure"
        xmlns:controls="clr-namespace:FocusPace.Controls"
        xmlns:models="clr-namespace:FocusPace.Models"
        Title="Focus Pace Widget"
        Width="176" Height="46" SizeToContent="Manual"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Topmost="{Binding WidgetAlwaysOnTop}" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <infra:ProgressWidthConverter x:Key="ProgressWidthConverter" />
        <ContextMenu x:Key="WidgetMenu" StaysOpen="False" HasDropShadow="False"
                     Style="{DynamicResource {x:Type ContextMenu}}"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <ContextMenu.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/FocusPace;component/Styles/TrayMenu.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                    <Style x:Key="CompactSubmenuItemStyle" TargetType="MenuItem"
                           BasedOn="{StaticResource {x:Type MenuItem}}" />
                </ResourceDictionary>
            </ContextMenu.Resources>
            <MenuItem Header="Open Focus Pace" Command="{Binding ShowSettingsCommand}" />
            <Separator />
            <MenuItem Header="{Binding PauseResumeText}" Command="{Binding PauseResumeCommand}" />
            <MenuItem Header="Restart session" Command="{Binding RestartCommand}" />
            <MenuItem Header="Extend by 5 minutes" Command="{Binding ExtendFocusCommand}" />
            <MenuItem Header="Start Focus" Command="{Binding StartFocusCommand}" />
            <MenuItem Header="Start Rest" Command="{Binding StartRestCommand}" />
            <Separator />
            <MenuItem Header="Hide widget" Command="{Binding HideWidgetCommand}" />
            <MenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}" />
            <Separator />
            <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="Pill" Opacity="{Binding WidgetOpacity}" ContextMenu="{StaticResource WidgetMenu}"
          MouseEnter="Pill_OnMouseEnter" MouseLeave="Pill_OnMouseLeave"
          MouseLeftButtonDown="Pill_OnMouseLeftButtonDown"
          MouseMove="Pill_OnMouseMove"
          MouseLeftButtonUp="Pill_OnMouseLeftButtonUp">
        <Border x:Name="BarPill" Visibility="{Binding IsBarWidget, Converter={StaticResource BooleanToVisibilityConverter}}"
                CornerRadius="14" Background="{DynamicResource WidgetSurfaceBrush}"
                BorderBrush="{DynamicResource InputSurfaceBrush}" BorderThickness="2" ClipToBounds="True">
            <Grid x:Name="BarTextLayer">
            <controls:AnimatedBarProgressControl Progress="{Binding Progress, Mode=OneWay}"
                                                  ProgressBrush="{Binding ProgressFillBrush}"
                                                  IsAnimated="{Binding IsWidgetAnimated}" />
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WidgetPhaseLabel}" Foreground="{DynamicResource WidgetTextBrush}" FontSize="13"
                               FontWeight="Normal" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource WidgetTextBrush}" FontSize="21"
                               FontWeight="Normal" VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>
                <Grid HorizontalAlignment="Left" ClipToBounds="True">
                    <Grid.Width>
                        <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                            <Binding ElementName="BarTextLayer" Path="ActualWidth" />
                            <Binding Path="Progress" />
                        </MultiBinding>
                    </Grid.Width>
                    <Grid Width="{Binding ActualWidth, ElementName=BarTextLayer}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WidgetPhaseLabel}" Foreground="{Binding ProgressTextBrush}" FontSize="13"
                                       FontWeight="Normal" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TimeText}" Foreground="{Binding ProgressTextBrush}" FontSize="21"
                                       FontWeight="Normal" VerticalAlignment="Center" Margin="9,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            </Grid>
        </Border>

        <Grid Visibility="{Binding IsRingWidget, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Ellipse Fill="{DynamicResource WidgetSurfaceBrush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" />
            <controls:CircularProgressControl Margin="7" Progress="{Binding Progress, Mode=OneWay}"
                                              ProgressBrush="{Binding ProgressFillBrush}"
                                              TrackBrush="{DynamicResource InputSurfaceBrush}" StrokeThickness="8"
                                              IsAnimated="{Binding IsWidgetAnimated}" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding WidgetPhaseLabel}" Foreground="{DynamicResource WidgetTextBrush}" FontSize="13" FontWeight="Normal" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource WidgetTextBrush}" FontSize="21" FontWeight="Normal" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding IsFluidWidget, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:FluidProgressControl Progress="{Binding Progress, Mode=OneWay}"
                                           ProgressBrush="{Binding ProgressFillBrush}"
                                           TrackBrush="{DynamicResource WidgetSurfaceBrush}"
                                           OutlineBrush="{DynamicResource InputSurfaceBrush}"
                                           IsAnimated="{Binding IsWidgetAnimated}" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding WidgetPhaseLabel}" Foreground="{Binding FluidPhaseTextBrush}" FontSize="13" FontWeight="Normal" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding TimeText}" Foreground="{Binding FluidTimeTextBrush}" FontSize="21" FontWeight="Normal" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
