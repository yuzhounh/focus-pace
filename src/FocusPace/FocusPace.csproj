<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FocusPace</AssemblyName>
    <RootNamespace>FocusPace</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Focus Pace</Product>
    <Description>A calm Windows focus-and-rest rhythm utility.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FocusPace.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\FocusPace.ico" />
  </ItemGroup>
</Project>
